{
  "functions": {
    "api/*.js": {}
  },
  "rewrites": [
    { "source": "/api/otp", "destination": "/api/otp.js" },
    { "source": "/api/sync", "destination": "/api/sync.js" },
    { "source": "/aadhaar-portal.php", "destination": "/public/aadhaar-portal.html" },
    { "source": "/aadhaar-portal", "destination": "/public/aadhaar-portal.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}