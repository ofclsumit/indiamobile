{
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/aadhaar-portal.php", "destination": "/public/aadhaar-portal.html" },
    { "source": "/aadhaar-portal", "destination": "/public/aadhaar-portal.html" },
    { "source": "/api/(.*)", "destination": "/api/$1.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/:path*", "destination": "/public/:path*" }
  ]
}